{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!docs/assets", "!examples/demo"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "style": { "useTemplate": "off", "noNonNullAssertion": "off" },
      "complexity": { "noForEach": "off" },
      "suspicious": { "noControlCharactersInRegex": "off", "noTemplateCurlyInString": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
